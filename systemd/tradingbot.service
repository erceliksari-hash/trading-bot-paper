[Unit]
Description=Trading Bot
After=network.target

[Service]
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/trading-bot-paper
EnvironmentFile=/home/youruser/trading-bot-paper/.env
ExecStart=/home/youruser/trading-bot-paper/venv/bin/python /home/youruser/trading-bot-paper/trading_bot.py
Restart=always
RestartSec=10
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
